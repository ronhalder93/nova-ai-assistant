require("dotenv").config();

const express = require("express");
const path = require("path");

const app = express();

app.use(express.json({ limit: "12mb" }));
app.use(express.static(__dirname));

app.get("/api/health", (req, res) => {
  res.json({
    ok: true,
    app: "Nova AI",
    chatConfigured: Boolean(process.env.OPENAI_API_KEY)
  });
});

app.post("/api/chat", async (req, res) => {
  try {
    const apiKey = process.env.OPENAI_API_KEY;

    if (!apiKey) {
      return res.status(503).json({
        error: "AI setup pending. Add OPENAI_API_KEY in Render environment variables."
      });
    }

    const incoming = Array.isArray(req.body.messages)
      ? req.body.messages
      : [];

    const messages = incoming
      .filter(message =>
        message &&
        ["user", "assistant"].includes(message.role) &&
        typeof message.content === "string"
      )
      .slice(-30)
      .map(message => ({
        role: message.role,
        content: message.content.slice(0, 12000)
      }));

    if (!messages.length) {
      return res.status(400).json({
        error: "Please type a message first."
      });
    }

    const response = await fetch(
      "https://api.openai.com/v1/chat/completions",
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${apiKey}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          model: process.env.OPENAI_MODEL || "gpt-4o-mini",
          messages: [
            {
              role: "system",
              content:
                "You are Nova AI, a helpful conversational assistant. Answer clearly and honestly. Do not claim image or video generation is available unless it is connected."
            },
            ...messages
          ],
          temperature: 0.7
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      console.error("AI provider error:", response.status);
      return res.status(502).json({
        error: data.error?.message || "AI provider request failed."
      });
    }

    res.json({
      reply:
        data.choices?.[0]?.message?.content ||
        "Sorry, I couldn't create a reply."
    });

  } catch (error) {
    console.error("Chat request failed:", error.message);
    res.status(500).json({
      error: "Server error. Please check Render logs."
    });
  }
});

app.get("*", (req, res) => {
  res.sendFile(path.join(__dirname, "index.html"));
});

const port = process.env.PORT || 3000;

app.listen(port, () => {
  console.log(`Nova AI running on port ${port}`);
});
